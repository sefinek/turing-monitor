<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AssemblyName>Turing Monitor</AssemblyName>
		<RootNamespace>TuringMonitor</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>app.ico</ApplicationIcon>

		<Company>Sefinek</Company>
		<Product>Turing Monitor</Product>
		<Title>Turing Monitor</Title>
		<FileDescription>System monitor for Turing Smart Screen displays with dashboard and theme rendering.</FileDescription>
		<Copyright>© 2026 Sefinek. MIT License.</Copyright>
		<Authors>Sefinek</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>

		<Version>0.1.0.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>

		<PackageProjectUrl>https://github.com/sefinek/TuringMonitor</PackageProjectUrl>
		<RepositoryUrl>https://github.com/sefinek/TuringMonitor</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Turing;SmartScreen;Monitor;Hardware;Dashboard</PackageTags>

		<PlatformTarget>x64</PlatformTarget>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<Prefer32Bit>false</Prefer32Bit>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
		<PackageReference Include="NLog" Version="6.1.3" />
		<PackageReference Include="System.IO.Ports" Version="10.0.9" />
		<PackageReference Include="System.Management" Version="10.0.9" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Update="NLog.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Remove="data\**" />
		<Content Include="data\**" Exclude="data\fonts\**\*_preview.png;data\**\*.xcf;data\**\*.svg;data\**\*.gs2;data\**\*.py">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
