<Window x:Class="TuringMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turing Monitor" Icon="/app.ico" Height="790" Width="1300" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
		              UseAeroCaptionButtons="False" />
	</WindowChrome.WindowChrome>

	<Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="44" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<Image Width="22" Height="22" Source="/app.ico" RenderOptions.BitmapScalingMode="HighQuality" />
					<TextBlock Text="Turing Monitor" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
					           VerticalAlignment="Center" />
					<TextBlock x:Name="lblVersion" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
					           Foreground="{StaticResource MutedBrush}" Cursor="Hand"
					           WindowChrome.IsHitTestVisibleInChrome="True"
					           MouseLeftButtonUp="lblVersion_Click" ToolTip="About" />
					<TextBlock x:Name="lblGitHub" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
					           Foreground="{StaticResource MutedBrush}" Cursor="Hand"
					           WindowChrome.IsHitTestVisibleInChrome="True"
					           MouseLeftButtonUp="lblGitHub_Click" ToolTip="Open the GitHub repository">
						<Run Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
						<Run Text=" GitHub" />
					</TextBlock>
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
					<Button x:Name="btnReadings" Style="{StaticResource CaptionButton}" Click="btnReadings_Click"
					        ToolTip="Live readings">
						<TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
					</Button>
					<Button x:Name="btnFolder" Style="{StaticResource CaptionButton}" Click="btnFolder_Click"
					        ToolTip="Open data folder">
						<TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
					</Button>
					<Button x:Name="btnSettings" Style="{StaticResource CaptionButton}" Click="btnSettings_Click"
					        ToolTip="Settings">
						<TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
					</Button>
					<Button x:Name="btnMin" Style="{StaticResource CaptionButton}" Click="btnMin_Click" ToolTip="Minimize">
						<TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
					</Button>
					<Button x:Name="btnClose" Style="{StaticResource CloseButton}" Click="btnClose_Click" ToolTip="Close">
						<TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
					</Button>
				</StackPanel>
			</Grid>

			<Grid Grid.Row="1" Margin="20,8,20,20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="3*" />
				</Grid.ColumnDefinitions>

				<DockPanel Grid.Column="0">
					<StackPanel DockPanel.Dock="Top">
						<TextBlock Text="DISPLAY PORT" Style="{StaticResource SectionLabel}" FontSize="13" />
						<Grid Margin="0,0,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ComboBox Grid.Column="0" x:Name="cmbPort" Style="{StaticResource ModernComboBox}"
							          SelectionChanged="cmbPort_SelectionChanged" />
							<Button Grid.Column="1" x:Name="btnRefresh" Style="{StaticResource GhostButton}"
							        Width="80" Height="34" Margin="8,0,0,0" Content="Refresh" Click="btnRefresh_Click" />
						</Grid>

						<Grid>
							<TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionLabel}" FontSize="13" HorizontalAlignment="Left" />
							<TextBlock x:Name="lblBrightness" Text="50%" Foreground="{StaticResource TextBrush}"
							           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Slider x:Name="sldBrightness" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100"
						        Value="50" TickFrequency="5" IsSnapToTickEnabled="True"
						        ValueChanged="sldBrightness_ValueChanged" Margin="0,0,0,4" />
					</StackPanel>

					<Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="10" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" x:Name="btnStart" Style="{StaticResource AccentButton}"
						        Height="38" Content="Start" Click="btnStart_Click" />
						<Button Grid.Column="2" x:Name="btnStop" Style="{StaticResource GhostButton}"
						        Height="38" Content="Stop" IsEnabled="False" Click="btnStop_Click" />
					</Grid>

					<Border Margin="0,14,0,0" CornerRadius="10" Padding="10"
					        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
					        BorderThickness="1">
						<TextBox x:Name="txtLog" IsReadOnly="True" Background="Transparent"
						         Foreground="{StaticResource MutedBrush}" BorderThickness="0"
						         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
						         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
					</Border>
				</DockPanel>

				<Border Grid.Column="2" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
				        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
					<DockPanel>
						<Grid DockPanel.Dock="Top" Margin="2,0,2,14">
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
								<TextBlock Text="SCREEN PREVIEW" Style="{StaticResource SectionLabel}" FontSize="13" Margin="0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
								<Ellipse x:Name="statusDot" Width="11" Height="11" Fill="{StaticResource MutedBrush}"
								         VerticalAlignment="Center" />
								<TextBlock x:Name="lblConn" Text="Disconnected" Margin="8,0,0,0" FontSize="13"
								           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
							</StackPanel>
						</Grid>

						<Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="14" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="ORIENTATION" Style="{StaticResource SectionLabel}" />
								<ComboBox x:Name="cmbOrientation" Style="{StaticResource ModernComboBox}"
								          SelectionChanged="cmbOrientation_SelectionChanged" />
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="THEME" Style="{StaticResource SectionLabel}" />
								<ComboBox x:Name="cmbTheme" Style="{StaticResource ModernComboBox}"
								          SelectionChanged="cmbTheme_SelectionChanged" />
							</StackPanel>
						</Grid>

						<Viewbox Stretch="Uniform">
							<Border CornerRadius="10" Background="#000000" Padding="0" SnapsToDevicePixels="True"
							        MinWidth="320" MinHeight="200">
								<Border.Effect>
									<DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000" />
								</Border.Effect>
								<Grid>
									<Image x:Name="imgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
									<StackPanel x:Name="previewHint" VerticalAlignment="Center" HorizontalAlignment="Center">
										<TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="44"
										           Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
										<TextBlock Text="Press Start to launch the preview"
										           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"
										           HorizontalAlignment="Center" />
									</StackPanel>
								</Grid>
							</Border>
						</Viewbox>
					</DockPanel>
				</Border>
			</Grid>

			<Grid x:Name="settingsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D8070910">
				<Border Width="720" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16"
				        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
				        BorderThickness="1" Padding="24">
					<StackPanel>
						<Grid Margin="0,0,0,22">
							<TextBlock Text="Settings" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
							<Button x:Name="btnSettingsClose" Style="{StaticResource CaptionButton}" Width="34" Height="30"
							        HorizontalAlignment="Right" Click="btnSettingsClose_Click" ToolTip="Close">
								<TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
							</Button>
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="32" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Startup" Style="{StaticResource GroupHeader}" />
								<CheckBox x:Name="chkResetOnStartup" Style="{StaticResource ToggleSwitch}"
								          Content="Reset display on startup" Margin="0,0,0,14" />
								<CheckBox x:Name="chkStartMinimized" Style="{StaticResource ToggleSwitch}"
								          Content="Start minimized" Margin="0,0,0,14" />
								<CheckBox x:Name="chkAutostart" Style="{StaticResource ToggleSwitch}"
								          Content="Run at Windows startup" Margin="0,0,0,14"
								          Checked="chkAutostart_CheckedChanged" Unchecked="chkAutostart_CheckedChanged" />
								<CheckBox x:Name="chkAutostartAdmin" Style="{StaticResource ToggleSwitch}"
								          Content="Run as administrator" Margin="24,0,0,14"
								          ToolTip="Registers a scheduled task instead of the normal startup entry, so the app launches elevated at logon (needed for sensors like CPU temperature). Windows will ask you to confirm with UAC once, right now, when you save." />
								<CheckBox x:Name="chkAutoStartMonitor" Style="{StaticResource ToggleSwitch}"
								          Content="Start monitoring on launch" Margin="0,0,0,14" />
								<CheckBox x:Name="chkAutoReconnect" Style="{StaticResource ToggleSwitch}"
								          Content="Auto-reconnect to display" Margin="0,0,0,14"
								          ToolTip="When the display disconnects, automatically try to reconnect every 5 seconds until it is found again or you press Stop." />
								<CheckBox x:Name="chkCheckForUpdates" Style="{StaticResource ToggleSwitch}"
								          Content="Check for updates on startup" Margin="0,0,0,24"
								          ToolTip="On launch, checks GitHub for a newer release. If one is found, the version label in the top-left corner turns into a link to the release page." />

								<TextBlock Text="General" Style="{StaticResource GroupHeader}" />
								<TextBlock Text="REFRESH INTERVAL" Style="{StaticResource SectionLabel}" />
								<ComboBox x:Name="cmbInterval" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16" />

								<TextBlock Text="DISK" Style="{StaticResource SectionLabel}" />
								<ComboBox x:Name="cmbDisk" Style="{StaticResource ModernComboBox}" Margin="0,0,0,24" />

								<TextBlock Text="Out of home" Style="{StaticResource GroupHeader}" />
								<CheckBox x:Name="chkExitWhenNoEthernet" Style="{StaticResource ToggleSwitch}"
								          Content="Exit when Ethernet is disconnected" Margin="0,0,0,14"
								          ToolTip="On launch, close automatically if there is no active wired Ethernet connection (Wi-Fi and virtual adapters are ignored)." />
								<CheckBox x:Name="chkExitWhenAway" Style="{StaticResource ToggleSwitch}"
								          Content="Away mode (exit until display is found)"
								          ToolTip="Turn this on before leaving. On launch it closes the app while the display is not connected, and switches itself off once the display is detected again." />
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Date &amp; Time" Style="{StaticResource GroupHeader}" />
								<TextBlock Text="LANGUAGE" Style="{StaticResource SectionLabel}" />
								<ComboBox x:Name="cmbLocale" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16" />

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="12" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="TIME FORMAT" Style="{StaticResource SectionLabel}" />
										<TextBox x:Name="txtTimeFormat" Style="{StaticResource ModernTextBox}"
										         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="DATE FORMAT" Style="{StaticResource SectionLabel}" />
										<TextBox x:Name="txtDateFormat" Style="{StaticResource ModernTextBox}"
										         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
									</StackPanel>
								</Grid>

								<TextBlock Text="Examples: HH:mm:ss · dddd, dd MMMM yyyy (names follow the language)"
								           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
								           Margin="0,0,0,24" />

								<TextBlock Text="Network" Style="{StaticResource GroupHeader}" />
								<TextBlock Text="INTERFACE" Style="{StaticResource SectionLabel}" />
								<ComboBox x:Name="cmbNetInterface" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="12" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="LINK SPEED" Style="{StaticResource SectionLabel}" />
										<ComboBox x:Name="cmbLinkSpeed" Style="{StaticResource ModernComboBox}" />
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="UNITS" Style="{StaticResource SectionLabel}" />
										<ComboBox x:Name="cmbUnits" Style="{StaticResource ModernComboBox}" />
									</StackPanel>
								</Grid>
							</StackPanel>
						</Grid>

						<Button Content="Save" Style="{StaticResource AccentButton}" Height="38" Margin="0,26,0,0"
						        Click="btnSaveSettings_Click" />
					</StackPanel>
				</Border>
			</Grid>

			<Grid x:Name="readingsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D8070910">
				<Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16"
				        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
				        BorderThickness="1" Padding="20">
					<StackPanel>
						<Grid Margin="0,0,0,18">
							<TextBlock Text="Live readings" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
							<Button x:Name="btnReadingsClose" Style="{StaticResource CaptionButton}" Width="34" Height="30"
							        HorizontalAlignment="Right" Click="btnReadingsClose_Click" ToolTip="Close">
								<TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
							</Button>
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,9">
							<Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource CpuAccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="CPU" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
							           Margin="10,0,0,0" VerticalAlignment="Center" />
							<TextBlock x:Name="rdCpuName" Text="—" FontSize="11" Foreground="{StaticResource MutedBrush}"
							           Margin="10,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Load" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdCpuLoad" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Clock" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdCpuClock" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,20">
							<TextBlock Text="Temperature" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdCpuTemp" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,9">
							<Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="GPU" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
							           Margin="10,0,0,0" VerticalAlignment="Center" />
							<TextBlock x:Name="rdGpuName" Text="—" FontSize="11" Foreground="{StaticResource MutedBrush}"
							           Margin="10,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Load" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdGpuLoad" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Temperature" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdGpuTemp" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,20">
							<TextBlock Text="Memory" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdGpuMem" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,9">
							<Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource RamAccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="MEMORY" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
							           Margin="10,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Used" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdRamUsed" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Total" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdRamTotal" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,20">
							<TextBlock Text="Usage" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdRamPct" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,9">
							<Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource DiskAccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="STORAGE" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
							           Margin="10,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Used" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdDiskUsed" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Total" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdDiskTotal" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,20">
							<TextBlock Text="Usage" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdDiskPct" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,9">
							<Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource NetAccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="NETWORK" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
							           Margin="10,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Download" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdNetDown" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,5">
							<TextBlock Text="Upload" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdNetUp" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
						<Grid Margin="14,0,0,0">
							<TextBlock Text="Link speed" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
							<TextBlock x:Name="rdNetLink" Text="—" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
						</Grid>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Border>
</Window>
